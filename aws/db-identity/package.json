{
  "name": "vibesdk-db-identity",
  "private": true,
  "version": "0.0.1",
  "description": "DynamoDB port of UserService/ApiKeyService (identity slice of D1), see docs/aws-dynamodb-schema.md. Not part of the main vibesdk build.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --root ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
