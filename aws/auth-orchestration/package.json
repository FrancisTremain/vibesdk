{
  "name": "vibesdk-auth-orchestration",
  "private": true,
  "version": "0.0.1",
  "description": "Port of AuthService (worker/database/services/AuthService.ts) -- register/login/logout/OAuth callback/account-linking orchestration, assembled from aws/db-identity, aws/db-auth-flows, aws/auth-crypto, and aws/oauth-clients. Not part of the main vibesdk build.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:@aws-sdk/*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --root ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "jose": "^5.6.3",
    "vibesdk-auth-crypto": "file:../auth-crypto",
    "vibesdk-db-auth-flows": "file:../db-auth-flows",
    "vibesdk-db-identity": "file:../db-identity",
    "vibesdk-oauth-clients": "file:../oauth-clients"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
